     "parameters": {},
     "seed_int": 0,
     "node_position": {
      "x": 0,
      "y": -350
     },
     "title": "Editable response, unchanged registered geometry",
     "text": "Normals use central differences at the actual 512px source grid, not a resized power-of-two grid. ReliefUV controls normal strength. AO derives from the original neighbourhood minus source light; roughness/transmission derive from the original tissue and luminance fields. Pigment/coverage controls remain independent. Final PNG8 packing does not feed any physical calculation. No32F buffer.",
     "size": {
      "x": 950,
      "y": 160
     },
     "color": {
