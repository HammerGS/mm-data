    {
      "name": "SourceNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": -330
      },
      "size": {
        "x": 1050,
        "y": 190
      },
      "title": "Sources and preserved appearance",
      "text": "Pigment is the exact current granite-contact RGB. Structure source is the original granite-bedrock RGB after the existing 512px resize and Poisson seam correction, BEFORE luminance, height blurs, normal or AO. Finished pigment cannot recover that field after tone flattening. Both are retained art inputs; no finished numeric map is imported.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
    {
      "name": "RecipeNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": 1050
      },
      "size": {
        "x": 1050,
        "y": 190
      },
      "title": "Editable recipe \u2014 8 m repeat, 0.08 m relief",
      "text": "Open the groups: exact .2126/.7152/.0722 luminance, 1.6px/6px Gaussian scales weighted .7/.3; explicit original source 1/99-percentile black/range. Central differences derive physical normals. AO uses .02/.08m neighborhoods and weights40/18. This is an artistic height estimate, not measured geometry. Native spatial/half-float filters differ from the original FFT recipe; native comparison is required.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
    {
      "name": "OutputNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 1200,
        "y": 1300
      },
      "size": {
        "x": 1050,
        "y": 190
      },
      "title": "Packed native exports \u2014 no Python material algorithm",
      "text": "512px PNG: granite-contact RGB pigment + A height; granite-contact-normal RGB U-right/V-down/Z-out normal + A AO; granite-contact-roughness numeric roughness. The preview uses MM normal convention. Base roughness .73 and height variation .08 match near dry granite; the old shader distance fade is not baked here. No RGBA32F. This pilot is staged, not accepted in-game.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
