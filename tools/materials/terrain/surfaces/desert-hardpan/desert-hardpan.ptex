        {
          "name": "Notes",
          "type": "comment",
          "parameters": {},
          "seed_int": 0,
          "node_position": {
            "x": 0,
            "y": -300
          },
          "title": "Registered source fields before material response",
          "text": "Original periodic noise/structure and exact two neighbourhood scales are retained in 16-bit byte planes. The native graph restores bytes before decoding; there is no finished normal, AO or roughness input. These fields preserve original feature placement where different native noise/filter kernels changed it. Do not insert a half buffer between decoding and differentiation: it would discard source precision.",
          "size": {
            "x": 950,
            "y": 160
          },
          "color": {
            "type": "Color",
            "r": 0.18,
            "g": 0.23,
            "b": 0.28,
