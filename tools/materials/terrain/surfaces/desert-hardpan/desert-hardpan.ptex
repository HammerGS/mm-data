        {
          "name": "Notes",
          "type": "comment",
          "parameters": {},
          "seed_int": 0,
          "node_position": {
            "x": 0,
            "y": -350
          },
          "title": "Physical response and packed height are separate",
          "text": "Original defaults: central differences of physical height produce the normal; two registered neighbourhood differences produce AO through exponential absorption. Relief scales those physical responses. Packed height is separately normalized to the original minimum/range for material blending, not the unnormalized physical height. NormalStrength retains the original recipe response explicitly. Roughness controls describe an optional absolute authored material. They affect the Material Maker preview; the game uses them only when Override contextual roughness is enabled in the top controls. Off preserves the existing role, hardness and distance response without a new roughness map. A single authored map intentionally replaces that context-dependent baseline; it cannot reproduce all of those responses. Wetness and other existing scene conditions still apply afterward.",
          "size": {
            "x": 950,
            "y": 160
          },
          "color": {
            "type": "Color",
            "r": 0.18,
            "g": 0.23,
            "b": 0.28,
            "a": 1
          }
        }
