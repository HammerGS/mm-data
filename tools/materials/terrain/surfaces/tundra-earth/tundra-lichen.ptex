    {
     "name": "Notes",
     "type": "comment",
     "parameters": {},
     "seed_int": 0,
     "node_position": {
      "x": 0,
      "y": -350
     },
     "title": "Physical response and packed height are separate",
     "text": "Shallow vegetation relief is inferred from the registered source value and native hummocks, not a measured height scan. Its physical scale is ReliefMetres over RepeatMetres. Real native Gaussian neighbours supply bounded cavity response; dark humus is not a deep geometric hole. No finished normal or AO image input.",
     "size": {
      "x": 950,
      "y": 160
     },
     "color": {
      "type": "Color",
      "r": 0.18,
      "g": 0.23,
      "b": 0.28,
      "a": 1
     }
    }
