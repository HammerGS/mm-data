  {
   "name": "preview_s",
   "label": "Severity preview (does not change game export)",
   "type": "shader",
   "node_position": {
    "x": 500,
    "y": -450
   },
   "parameters": {
    "severity": 1
   },
   "shader_model": {
    "name": "SCORCHED severity preview",
    "code": "",
    "global": "",
    "inputs": [
     {
      "name": "reference",
      "type": "rgb",
      "default": "vec3(.3)",
      "function": true
     },
     {
      "name": "roughness",
      "type": "f",
      "default": ".9",
      "function": true
     },
     {
      "name": "height",
      "type": "f",
      "default": ".5",
      "function": true
     }
    ],
    "parameters": [
     {
      "name": "severity",
      "type": "float",
      "label": "Scorch severity",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01
     }
    ],
    "instance": [
     "vec4 scorch_preview_$name(vec2 uv) {\nvec3 encoded=$reference(uv);\nvec3 ref=mix(pow((encoded+.055)/1.055,vec3(2.4)),encoded/12.92,lessThanEqual(encoded,vec3(.04045)));\nfloat r=$roughness(uv), h=$height(uv), s=$severity;\nfloat y=dot(ref,vec3(.2126,.7152,.0722));\nfloat c=smoothstep(.12,.45,s)*(1.0-smoothstep(.03,.10,y));\nfloat G=smoothstep(.78,.97,s);\nfloat a=smoothstep(.35,.68,s)*smoothstep(.10,.26,y)*(1.0-.65*G);\nfloat g=G*(1.0-smoothstep(.35,.65,r));\nvec4 w=vec4((1.0-g)*(1.0-a)*(1.0-c),(1.0-g)*(1.0-a)*c,(1.0-g)*a,g);\nvec3 color=mix(.8,1.2,h)*(w.x*vec3(.060,.043,.026)+w.y*vec3(.016,.018,.017)+w.z*vec3(.230,.220,.200)+w.w*vec3(.028,.037,.030));\nfloat coverage=smoothstep(0.0,.55,s);\ncolor=mix(ref,color,coverage);\nfloat rs=dot(w,vec4(.90,.86,.97,clamp(r,.18,.38)));\nfloat rough=sqrt(mix(r*r,rs*rs,coverage));\nreturn vec4(mix(1.055*pow(color,vec3(1.0/2.4))-.055,12.92*color,lessThanEqual(color,vec3(.0031308))),rough);\n}"
    ],
    "outputs": [
     {
      "type": "rgb",
      "rgb": "scorch_preview_$name($uv).rgb"
     },
     {
      "type": "f",
      "f": "scorch_preview_$name($uv).a"
     }
    ]
   }
  },
