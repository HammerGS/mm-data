    {
      "name": "PNGEncodingNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 1250,
        "y": 1450
      },
      "size": {
        "x": 1100,
        "y": 200
      },
      "title": "Numeric storage boundary, not a material gain",
      "text": "Only finished normal RGB and surface RGBA use clamp((round(clamp(v,0,1)*255)+.5)/255,0,1). This puts each nearest PNG8 code inside its native conversion bin. The physical relief, height, normal calculation and pigment branch are unchanged. In particular surface A stores the same relief code used by the normal calculation; the half-code offset never feeds the material.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
