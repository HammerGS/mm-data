    {
      "name": "SourceNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": -350
      },
      "size": {
        "x": 1100,
        "y": 200
      },
      "title": "Editable source art, no finished data maps",
      "text": "Exact current pigment and registered pre-response fields preserve original appearance. Two PNG8 byte planes retain16-bit fields through the native half image loader. Native nodes recompute normals and optical/material response; no finished normal/AO/roughness image inputs. Original filtering and source registration are fixed in necessary fields, not approximated by different native filters. Final PNG8 boundary never feeds response calculations.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
    {
      "name": "RecipeNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": 1100
      },
      "size": {
        "x": 1100,
        "y": 200
      },
      "title": "Native grain / material response",
      "text": "Exact current pigment and registered pre-response fields preserve original appearance. Two PNG8 byte planes retain16-bit fields through the native half image loader. Native nodes recompute normals and optical/material response; no finished normal/AO/roughness image inputs. Original filtering and source registration are fixed in necessary fields, not approximated by different native filters. Final PNG8 boundary never feeds response calculations.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
    {
      "name": "OutputNotes",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 1250,
        "y": 1100
      },
      "size": {
        "x": 1100,
        "y": 200
      },
      "title": "Existing game channels and units",
      "text": "Exports: RGB color; RGB normal (127*n+128)/255; surface RGBA = height, roughness, cavity AO, relief UV / .1. Relief is quantized once and the identical value drives central-difference normals. Repeat stays at the current runtime 1m; relief is editable. Native preview uses Material Maker normal convention. No shader or road/rail/bridge shape changes.",
      "color": {
        "type": "Color",
        "r": 0.14,
        "g": 0.24,
        "b": 0.3,
        "a": 1
      }
    },
