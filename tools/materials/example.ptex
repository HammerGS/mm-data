          "from_port": 1,
          "to": "NormalAO",
          "to_port": 1
        },
        {
          "from": "PigmentChannels",
          "from_port": 2,
          "to": "ColorHeight",
          "to_port": 2
        },
        {
          "from": "NormalChannels",
          "from_port": 2,
