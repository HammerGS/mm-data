      ]
    },
    {
      "export": {},
      "name": "Material",
      "node_position": {
        "x": 1250,
        "y": 100
      },
      "parameters": {
        "albedo_color": {
          "a": 1,
          "b": 1,
          "g": 1,
          "r": 1,
          "type": "Color"
        },
        "ao": 1,
        "depth_scale": 0.5,
        "emission_energy": 1,
        "flags_transparent": false,
        "metallic": 0,
        "normal": 1,
        "roughness": 1,
        "size": 9,
        "sss": 1,
        "RepeatMetres": 4,
        "ReliefMetres": 0.025
      },
      "seed_int": 0,
      "shader_model": {
        "shortdesc": "Static PBR Material",
        "longdesc": "PBR material with maps generated as static images",
        "code": "",
        "exports": {
          "MegaMek/Maps": {
            "export_extension": ".json",
            "files": [
              {
                "type": "template",
                "file_name": "$(path_prefix).json",
                "template": "{\n  \"tile\": $(param:RepeatMetres),\n  \"relief_metres\": $(param:ReliefMetres),\n  \"roughness_map\": \"$(file_prefix)-roughness.png\"\n}\n"
              }
            ]
          }
        },
        "global": "",
        "inputs": [
          {
            "default": "vec3(1.0)",
            "group_size": 7,
            "label": "",
            "name": "albedo_tex",
            "type": "rgb"
          },
          {
            "default": "$metallic",
            "label": "",
            "name": "metallic_tex",
            "type": "f"
          },
          {
            "default": "1.0",
            "label": "",
            "name": "roughness_tex",
            "type": "f"
          },
          {
            "default": "vec3(0.0)",
            "label": "",
            "name": "emission_tex",
            "type": "rgb"
          },
          {
            "default": "vec3(0.5)",
            "label": "",
            "name": "normal_tex",
            "type": "rgb"
          },
          {
            "default": "1.0",
            "label": "",
            "name": "ao_tex",
            "type": "f"
          },
          {
            "default": "0.0",
            "label": "",
            "name": "depth_tex",
            "type": "f"
          },
          {
            "default": "1.0",
            "label": "",
            "name": "opacity_tex",
            "type": "f"
          },
          {
            "default": "0.0",
            "label": "",
            "name": "sss_tex",
            "type": "f"
          }
        ],
        "instance": "",
        "name": "Static PBR Material",
        "outputs": [
          {
            "rgba": "vec4($albedo_tex($uv), $opacity_tex($uv))",
            "type": "rgba"
          },
          {
            "rgb": "vec3($ao_tex($uv), $roughness_tex($uv), $metallic_tex($uv))",
            "type": "rgb"
          },
          {
            "rgb": "$emission_tex($uv)",
            "type": "rgb"
          },
          {
            "rgb": "$normal_tex($uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0)",
            "type": "rgb"
          },
          {
            "f": "clamp($depth_tex($uv), 0.0, 1.0)",
            "type": "f"
          },
          {
            "f": "$sss_tex($uv)",
            "type": "f"
          },
          {
            "rgba": "vec4(vec3($metallic_tex($uv)), 1.0-$roughness_tex($uv))",
            "type": "rgba"
          },
          {
            "rgb": "$normal_tex($uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0)",
            "type": "rgb"
          },
          {
            "f": "1.0-$depth_tex($uv)",
            "type": "f"
          },
          {
            "f": "$ao_tex($uv)",
            "type": "f"
          },
          {
            "rgb": "$normal_tex($uv)*vec3(-1.0)+vec3(1.0)",
            "type": "rgb"
          },
          {
            "rgba": "vec4($metallic_tex($uv), $ao_tex($uv), 1.0, 1.0-$roughness_tex($uv))",
            "type": "rgba"
          },
          {
            "f": "$metallic_tex($uv)",
            "type": "f"
          },
          {
            "f": "$roughness_tex($uv)",
            "type": "f"
          }
        ],
        "parameters": [
          {
            "default": {
              "a": 1,
              "b": 1,
              "g": 1,
              "r": 1
            },
            "label": "Albedo",
            "name": "albedo_color",
            "type": "color"
          },
          {
            "control": "None",
            "default": 1,
            "label": "Metallic",
            "max": 1,
            "min": 0,
            "name": "metallic",
            "step": 0.01,
            "type": "float"
          },
          {
            "control": "None",
            "default": 1,
            "label": "Roughness",
            "max": 1,
            "min": 0,
            "name": "roughness",
            "step": 0.01,
            "type": "float"
          },
          {
            "control": "None",
            "default": 1,
            "label": "Emission",
            "max": 1,
            "min": 0,
            "name": "emission_energy",
            "step": 0.01,
            "type": "float"
          },
          {
            "control": "None",
            "default": 1,
            "label": "Normal",
            "max": 10,
            "min": 0,
            "name": "normal",
            "step": 0.01,
            "type": "float"
          },
          {
            "control": "None",
            "default": 1,
            "label": "Ambient occlusion",
            "max": 1,
            "min": 0,
            "name": "ao",
            "step": 0.01,
            "type": "float"
          },
          {
            "control": "None",
            "default": 0.5,
            "label": "Depth",
            "max": 1,
            "min": 0,
            "name": "depth_scale",
            "step": 0.01,
            "type": "float"
          },
          {
            "default": false,
            "label": "Transparency",
            "name": "flags_transparent",
            "type": "boolean"
          },
          {
            "control": "None",
            "default": 0,
            "label": "Subsurf. scatter.",
            "max": 1,
            "min": 0,
            "name": "sss",
            "step": 0.01,
            "type": "float"
          },
          {
            "default": 11,
            "first": 6,
            "label": "Size",
            "last": 13,
            "name": "size",
            "type": "size"
          },
          {
            "name": "RepeatMetres",
            "label": "Repeat (metres) (linked)",
            "type": "float",
            "control": "None",
            "default": 4,
            "min": 1,
            "max": 32,
            "step": 0.1
          },
          {
            "name": "ReliefMetres",
            "label": "Relief (metres) (linked)",
            "type": "float",
            "control": "None",
            "default": 0.025,
            "min": 0,
            "max": 0.25,
            "step": 0.001
          }
        ],
        "preview_shader": [
          "shader_type spatial;",
          "render_mode blend_mix,cull_back,diffuse_burley,specular_schlick_ggx",
          "$if $(connected:opacity_tex) and $(param:flags_transparent)",
          ",depth_prepass_alpha",
          "$fi",
          ";",
          "",
          "uniform sampler2D texture_albedo : source_color; // $output(0)",
          "uniform sampler2D texture_emission : hint_default_black; // $output(2)",
          "uniform sampler2D texture_normal : hint_normal; // $output(3)",
          "uniform sampler2D texture_orm : hint_default_white; // $output(1)",
          "uniform sampler2D texture_subsurface_scattering : hint_default_white; // $output(5)",
          "uniform sampler2D texture_depth : hint_default_black; // $output(4)",
          "uniform int depth_min_layers = 64;",
          "uniform int depth_max_layers = 64;",
          "uniform vec2 depth_flip = vec2(1.0);",
          "",
          "uniform vec3 uv1_scale;",
          "uniform vec3 uv1_offset;",
          "",
          "$definitions",
          "",
          "void vertex() {",
          "\tUV=UV*uv1_scale.xy+uv1_offset.xy;",
          "}",
          "",
          "void fragment() {",
          "\tvec2 base_uv = UV;",
          "\tint texture_size = textureSize(texture_albedo, 0).x;",
          "\tif (texture_size < 256) {",
          "\t\tbase_uv = floor(float(texture_size)*base_uv+0.5)/float(texture_size);",
          "\t}",
          "$if $(connected:depth_tex)",
          "\t{",
          "$begin_generate",
          "\t\tfloat depth_scale = 0.2*$depth_scale;",
          "$end_generate",
          "\t\tvec3 view_dir = normalize(normalize(-VERTEX)*mat3(TANGENT*depth_flip.x,-BINORMAL*depth_flip.y,NORMAL));",
          "\t\tfloat num_layers = mix(float(depth_max_layers),float(depth_min_layers), abs(dot(vec3(0.0, 0.0, 1.0), view_dir)));",
          "\t\tfloat layer_depth = 1.0 / num_layers;",
          "\t\tfloat current_layer_depth = 0.0;",
          "\t\tvec2 P = view_dir.xy * depth_scale;",
          "\t\tvec2 delta = P / num_layers / dot(VIEW, NORMAL);",
          "\t\tvec2  ofs = base_uv;",
          "\t\tfloat depth = textureLod(texture_depth, ofs,0.0).r;",
          "\t\tfloat current_depth = 0.0;",
          "\t\twhile(current_depth < depth) {",
          "\t\t\tofs -= delta;",
          "\t\t\tdepth = textureLod(texture_depth, ofs,0.0).r;",
          "\t\t\tcurrent_depth += layer_depth;",
          "\t\t}",
          "\t\tvec2 prev_ofs = ofs + delta;",
          "\t\tfloat after_depth  = depth - current_depth;",
          "\t\tfloat before_depth = textureLod(texture_depth, prev_ofs, 0.0).r - current_depth + layer_depth;",
          "\t\tfloat weight = after_depth / (after_depth - before_depth);",
          "\t\tofs = mix(ofs,prev_ofs,weight);",
          "\t\tbase_uv=ofs;",
          "\t}",
          "$fi",
          "$begin_generate",
          "\tvec4 albedo_tex = texture(texture_albedo, base_uv);",
          "\tALBEDO = $albedo_color.rgb * mix(pow((albedo_tex + vec4(0.055))/vec4(1.055), vec4(2.4)), albedo_tex/vec4(12.92), lessThan(albedo_tex, vec4(0.04045))).rgb;",
          "\tvec4 orm_tex = texture(texture_orm, base_uv);",
          "\tMETALLIC = $metallic*orm_tex.b;",
          "\tROUGHNESS = $roughness*orm_tex.g;",
          "\tSPECULAR = 0.5;",
          "\tNORMAL_MAP = texture(texture_normal, base_uv).rgb;",
          "\tNORMAL_MAP_DEPTH = $normal;",
          "\tvec3 emission_tex = texture(texture_emission, base_uv).rgb;",
          "\tEMISSION = emission_tex*$emission_energy;",
          "\tAO = orm_tex.r;",
          "\tAO_LIGHT_AFFECT = $ao;",
          "$if $(connected:opacity_tex) and $(param:flags_transparent)",
          "\tALPHA = albedo_tex.a;",
          "$fi",
          "$if $(connected:sss_tex)",
          "\tfloat sss_tex = texture(texture_subsurface_scattering, base_uv).r;",
          "\tSSS_STRENGTH=$sss*sss_tex;",
          "$fi",
          "$end_generate",
          "}",
          ""
        ]
      },
      "type": "material_export"
    },
    {
      "name": "StartHere",
      "type": "comment",
      "node_position": {
        "x": 0,
        "y": -350
      },
      "parameters": {},
      "seed": 27,
      "seed_locked": true,
      "title": "Start here: editable rough earth / stone",
      "size": {
        "x": 1200,
        "y": 240
      },
      "color": {
        "type": "Color",
        "r": 0.2,
        "g": 0.26,
        "b": 0.18,
        "a": 1
      },
      "text": "Copy this file to <family>/<name>/<name>.ptex, rename the project to match, then edit the controls on groups 1\u20133. No source images are required. Base color is an sRGB pigment choice; grain color is mixed in linear RGB. Repeat defaults to 4 metres; relief changes normals and cavity shading, not the normalized height pattern. The seed and grain scale control the same seamless surface used by all maps. Roughness is independent. Choose MegaMek/Maps for direct packed exports: RGB pigment + A height; RGB engine normal + A AO; roughness. The final numeric encoding group only selects the nearest PNG8 code, leaving pigment and physical calculations alone. Grid is fixed at 512. This starter is an artistic material, not measured rock; inspect its native bake before game use. Use the top Scale and relief remote for the shared physical/export values; do not independently edit its linked targets. MegaMek/Maps also exports <name>.json containing tile, relief_metres and the roughness filename. Save, run export.py, then RELOAD ASSETS after the export succeeds."
    },
